\@writefile{lof}{\contentsline {figure}{\numberline {27}{\ignorespaces  Two-dimensional Gaussian fit applied to the identified carbon isotopes in TWIN MUSIC, using a 3.5$\sigma $ fitting range. The zoomed projections along the horizontal and vertical axes with the corresponding fit cuts illustrate events where either the eight downstream or eight upstream anodes registered no hit entries. The central cluster corresponds to boron isotopes. The broad cluster observed on the lower left corner originates from events in which the $^{12}$C ion undergoes fragmentation into multiple light charged particles. In such cases, the total energy loss of the combined fragments is measured in TWIN MUSIC, preventing individual particle separation. \relax }}{69}{figure.caption.32}}
\newlabel{fig:twin_2d_gaus_cut}{{27}{69}{Two-dimensional Gaussian fit applied to the identified carbon isotopes in TWIN MUSIC, using a 3.5$\sigma $ fitting range. The zoomed projections along the horizontal and vertical axes with the corresponding fit cuts illustrate events where either the eight downstream or eight upstream anodes registered no hit entries. The central cluster corresponds to boron isotopes. The broad cluster observed on the lower left corner originates from events in which the $^{12}$C ion undergoes fragmentation into multiple light charged particles. In such cases, the total energy loss of the combined fragments is measured in TWIN MUSIC, preventing individual particle separation. \relax }{figure.caption.32}{}}
\newlabel{fig:twin_2d_gaus_cut@cref}{{[figure][27][]27}{[1][66][]69}}
\@writefile{lof}{\contentsline {figure}{\numberline {28}{\ignorespaces  Raw estimate of the charge-changing cross sections. The number of surviving carbon ions is obtained from the correlation distribution of the reconstructed mean charge measured in the upstream and downstream anodes, by integrating all events within the two-dimensional Gaussian fit contour. Events for which only one of the anode planes produced a valid signal are included when their single charge value falls within the corresponding one-dimensional Gaussian projection of the same fit. The resulting surviving carbon isotope yields for target and empty-target runs are used to derive the raw charge-changing cross section, see Eq.~\ref  {eq:cs_cc_show}. Only statistical uncertainties are displayed. \relax }}{70}{figure.caption.33}}
\newlabel{fig:cccs_gaus_with_errors}{{28}{70}{Raw estimate of the charge-changing cross sections. The number of surviving carbon ions is obtained from the correlation distribution of the reconstructed mean charge measured in the upstream and downstream anodes, by integrating all events within the two-dimensional Gaussian fit contour. Events for which only one of the anode planes produced a valid signal are included when their single charge value falls within the corresponding one-dimensional Gaussian projection of the same fit. The resulting surviving carbon isotope yields for target and empty-target runs are used to derive the raw charge-changing cross section, see Eq.~\ref {eq:cs_cc_show}. Only statistical uncertainties are displayed. \relax }{figure.caption.33}{}}
\newlabel{fig:cccs_gaus_with_errors@cref}{{[figure][28][]28}{[1][66][]70}}
\@writefile{lof}{\contentsline {figure}{\numberline {29}{\ignorespaces  Estimate of the charge changing cross sections depending on the fit range applied on the Fig.~\ref  {fig:twin_2d_gaus_cut} for the different target thicknesses and beam energies. The observed decrease in cross section values with increasing fit range is attributed to the energy dependence of the ionization energy loss. At higher fit ranges, the contribution from tails of the energy loss distribution of lighter fragments (e.g., Z = 5) becomes increasingly included in the integration window for heavier fragments (e.g., Z = 6), leading to an underestimation of the charge-changing cross section. This effect becomes more pronounced at higher beam energies, where the relative resolution decreases due to the flattening of the Bethe-Bloch curve, thereby enhancing the probability of misidentification between adjacent nuclear charges. \relax }}{71}{figure.caption.34}}
\newlabel{fig:cccs_vs_sigma_cut}{{29}{71}{Estimate of the charge changing cross sections depending on the fit range applied on the Fig.~\ref {fig:twin_2d_gaus_cut} for the different target thicknesses and beam energies. The observed decrease in cross section values with increasing fit range is attributed to the energy dependence of the ionization energy loss. At higher fit ranges, the contribution from tails of the energy loss distribution of lighter fragments (e.g., Z = 5) becomes increasingly included in the integration window for heavier fragments (e.g., Z = 6), leading to an underestimation of the charge-changing cross section. This effect becomes more pronounced at higher beam energies, where the relative resolution decreases due to the flattening of the Bethe-Bloch curve, thereby enhancing the probability of misidentification between adjacent nuclear charges. \relax }{figure.caption.34}{}}
\newlabel{fig:cccs_vs_sigma_cut@cref}{{[figure][29][]29}{[1][67][]71}}
