\@writefile{lof}{\contentsline {figure}{\numberline {56}{\ignorespaces Correlation between the fission fragment charges and the total fission fragment mass $M_{\text  {tot}} = M_{\text  {FF1}} + M_{\text  {FF2}}$ for the $(p,2pf)$ reaction channel. The excitation energy (in MeV) is represented by the color scale. Higher excitation energies lead to increased neutron evaporation, resulting in a reduced total fission fragment mass. Lower values of $M_{\text  {tot}}$ are associated with a more symmetric charge split, demonstrating a clear transition from predominantly asymmetric to symmetric fission with increasing excitation energy (i.e.\ decreasing total mass). Figure adopted from~\cite  {gabriel_private_2024}\relax }}{123}{figure.caption.63}}
\newlabel{fig:ff_charge_mass}{{56}{123}{Correlation between the fission fragment charges and the total fission fragment mass $M_{\text {tot}} = M_{\text {FF1}} + M_{\text {FF2}}$ for the $(p,2pf)$ reaction channel. The excitation energy (in MeV) is represented by the color scale. Higher excitation energies lead to increased neutron evaporation, resulting in a reduced total fission fragment mass. Lower values of $M_{\text {tot}}$ are associated with a more symmetric charge split, demonstrating a clear transition from predominantly asymmetric to symmetric fission with increasing excitation energy (i.e.\ decreasing total mass). Figure adopted from~\cite {gabriel_private_2024}\relax }{figure.caption.63}{}}
\newlabel{fig:ff_charge_mass@cref}{{[figure][56][]56}{[1][119][]123}}
