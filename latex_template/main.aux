\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces Time difference $\Delta t_{\mathrm  {right-left}}$ between hits in the Start detector for events with exactly one hit on both the left and right photomultipliers. The nominal search window of the Start detector was 2,$\mu $s, set to accommodate the maximum signal rise time and the maximal scintillation light propagation delay. For this analysis, the time difference was initially limited to the range $0.555\ \mathrm  {ns} \leq \Delta t_{\mathrm  {right-left}} \leq 1.946\ \mathrm  {ns}$, and a further restricted window of $0.555\ \mathrm  {ns} \leq \Delta t_{\mathrm  {right-left}} \leq 0.95\ \mathrm  {ns}$ (indicated by red vertical lines) was used to isolate a clean signal. Thick target run, 800 AMeV.\relax }}{60}{figure.caption.27}}
\newlabel{fig:start_good_event_sel}{{23}{60}{Time difference $\Delta t_{\mathrm {right-left}}$ between hits in the Start detector for events with exactly one hit on both the left and right photomultipliers. The nominal search window of the Start detector was 2,$\mu $s, set to accommodate the maximum signal rise time and the maximal scintillation light propagation delay. For this analysis, the time difference was initially limited to the range $0.555\ \mathrm {ns} \leq \Delta t_{\mathrm {right-left}} \leq 1.946\ \mathrm {ns}$, and a further restricted window of $0.555\ \mathrm {ns} \leq \Delta t_{\mathrm {right-left}} \leq 0.95\ \mathrm {ns}$ (indicated by red vertical lines) was used to isolate a clean signal. Thick target run, 800 AMeV.\relax }{figure.caption.27}{}}
\newlabel{fig:start_good_event_sel@cref}{{[figure][23][]23}{[1][59][]60}}
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces Reconstructed \(x\)-\(y\) position of incoming ions on MWPC0 without applying a charge selection on the R3B MUSIC detector. The position reconstruction was performed without enforcing any multiplicity cut on the number of hits in MWPC0. However, a strict selection of \(\pm 2\sigma \) around the beam spot center was applied independently in \(x\) and \(y\), as indicated by the red rectangular region. A detailed description of the MWPC0 hit selection procedure is provided in Appendix~\ref  {app:mw0_cuts}.\relax }}{61}{figure.caption.28}}
\newlabel{fig:mw0_xy_overview}{{24}{61}{Reconstructed \(x\)-\(y\) position of incoming ions on MWPC0 without applying a charge selection on the R3B MUSIC detector. The position reconstruction was performed without enforcing any multiplicity cut on the number of hits in MWPC0. However, a strict selection of \(\pm 2\sigma \) around the beam spot center was applied independently in \(x\) and \(y\), as indicated by the red rectangular region. A detailed description of the MWPC0 hit selection procedure is provided in Appendix~\ref {app:mw0_cuts}.\relax }{figure.caption.28}{}}
\newlabel{fig:mw0_xy_overview@cref}{{[figure][24][]24}{[1][60][]61}}
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces  Selection of incoming beam particles based on reconstructed target coordinates. The $x$-position at the target is propagated from the measured $x$-coordinate in MWPC0 and the trajectory angle determined by the R3B MUSIC detector. The target area is $3 \times 3$\tmspace  +\thinmuskip {.1667em}cm$^2$, indicated by the black dotted lines representing its spatial boundaries in $x$. Events selected with cuts of $\pm 2\sigma $ in both $x$ and $y$ positions at MWPC0 and a $\pm 1\sigma $ charge selection in R3B MUSIC are shown in red, while all unfiltered incoming events are shown in blue. This clearly demonstrates that the selected incoming ions hit well the target. Thin target run, 550\tmspace  +\thinmuskip {.1667em}AMeV. \relax }}{62}{figure.caption.29}}
\newlabel{fig:x_pos_target}{{25}{62}{Selection of incoming beam particles based on reconstructed target coordinates. The $x$-position at the target is propagated from the measured $x$-coordinate in MWPC0 and the trajectory angle determined by the R3B MUSIC detector. The target area is $3 \times 3$\,cm$^2$, indicated by the black dotted lines representing its spatial boundaries in $x$. Events selected with cuts of $\pm 2\sigma $ in both $x$ and $y$ positions at MWPC0 and a $\pm 1\sigma $ charge selection in R3B MUSIC are shown in red, while all unfiltered incoming events are shown in blue. This clearly demonstrates that the selected incoming ions hit well the target. Thin target run, 550\,AMeV. \relax }{figure.caption.29}{}}
\newlabel{fig:x_pos_target@cref}{{[figure][25][]25}{[1][60][]62}}
