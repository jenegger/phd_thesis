\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Total interaction cross sections $\sigma _{\mathrm  {I}}$ for the system \textsuperscript  {12}C + \textsuperscript  {12}C as a function of beam energy per nucleon. Black circles denote predictions from standard Glauber model calculations, while red diamonds include in-medium corrections accounting for Coulomb repulsion and Pauli blocking. Experimental data from previous studies by Takechi et al.~\cite  {takechi2009reaction}, Tanihata et al.~\cite  {tanihata1990rnbeams}, and Ozawa et al.~\cite  {ozawa2001measurements} are shown as blue dots. Recent experimental results obtained by Ponnath et al.~\cite  {ponnath2024measurement} are depicted in green, differentiated by target thickness (circles: thin, squares: medium, triangles: thick). A systematic discrepancy remains between the in-medium corrected Glauber calculations and experimental data in the energy range of 800--1000\,AMeV, where the theoretical predictions tend to overestimate the measured cross sections. Figure taken from Ref.~\cite  {ponnath2024measurement}. \relax }}{20}{figure.caption.7}\protected@file@percent }
\newlabel{fig:carbon12_interaction_cs}{{7}{20}{Total interaction cross sections $\sigma _{\mathrm {I}}$ for the system \textsuperscript {12}C + \textsuperscript {12}C as a function of beam energy per nucleon. Black circles denote predictions from standard Glauber model calculations, while red diamonds include in-medium corrections accounting for Coulomb repulsion and Pauli blocking. Experimental data from previous studies by Takechi et al.~\cite {takechi2009reaction}, Tanihata et al.~\cite {tanihata1990rnbeams}, and Ozawa et al.~\cite {ozawa2001measurements} are shown as blue dots. Recent experimental results obtained by Ponnath et al.~\cite {ponnath2024measurement} are depicted in green, differentiated by target thickness (circles: thin, squares: medium, triangles: thick). A systematic discrepancy remains between the in-medium corrected Glauber calculations and experimental data in the energy range of 800--1000\,AMeV, where the theoretical predictions tend to overestimate the measured cross sections. Figure taken from Ref.~\cite {ponnath2024measurement}. \relax }{figure.caption.7}{}}
\newlabel{fig:carbon12_interaction_cs@cref}{{[figure][7][]7}{[1][20][]20}}
\citation{teixeira2022nuclear}
