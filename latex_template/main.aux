\@writefile{lof}{\contentsline {figure}{\numberline {60}{\ignorespaces Three-dimensional chart of nuclides illustrating the evolution of asymmetric fission, with asymmetry \( A \) shown as a color scale. The red circles indicate two distinct regions-so-called ``islands''-of asymmetric fission. The region in the upper right corresponds to the well-established asymmetric fission in the actinide range (atomic numbers \( Z = 89\text  {--}103 \)), where the process is stabilized by the formation of a heavy fragment near xenon (\( Z = 54 \)). In contrast, the region in the lower left highlights the recently discovered asymmetric fission of lighter nuclei around mercury (\( Z = 80 \)), stabilized by the formation of a light fragment near krypton (\( Z = 36 \)). Black squares denote the valley of beta-stable isotopes. \textit  {Image credit: Pierre Morfouace,CEA,DAM,DIF,Arpajon, France.}\relax }}{117}{figure.caption.65}\protected@file@percent }
\newlabel{fig:asymmetric_fission_islands}{{60}{117}{Three-dimensional chart of nuclides illustrating the evolution of asymmetric fission, with asymmetry \( A \) shown as a color scale. The red circles indicate two distinct regions-so-called ``islands''-of asymmetric fission. The region in the upper right corresponds to the well-established asymmetric fission in the actinide range (atomic numbers \( Z = 89\text {--}103 \)), where the process is stabilized by the formation of a heavy fragment near xenon (\( Z = 54 \)). In contrast, the region in the lower left highlights the recently discovered asymmetric fission of lighter nuclei around mercury (\( Z = 80 \)), stabilized by the formation of a light fragment near krypton (\( Z = 36 \)). Black squares denote the valley of beta-stable isotopes. \textit {Image credit: Pierre Morfouace,CEA,DAM,DIF,Arpajon, France.}\relax }{figure.caption.65}{}}
\newlabel{fig:asymmetric_fission_islands@cref}{{[figure][60][]60}{[1][116][]117}}
