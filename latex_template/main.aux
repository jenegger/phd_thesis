\@writefile{lof}{\contentsline {figure}{\numberline {53}{\ignorespaces  Doppler-corrected $\gamma $-ray spectrum in coincidence with the $^{12}\mathrm  {C}(p,2p)^{11}\mathrm  {B}$ quasi-free scattering reaction. The prominent peak at $E_{\gamma } \approx 2.1\,\mathrm  {MeV}$ corresponds to the de-excitation of the $^{11}\mathrm  {B}$ nucleus from its first excited state ($1/2^-$) to the ground state. This peak is fitted with a Gaussian function (blue), while the underlying background is described by an exponential distribution (green). A broader and less well-defined structure is observed at $E_{\gamma } \approx 5\,\mathrm  {MeV}$, associated with the de-excitation of the $3/2^-$ state. \relax }}{109}{figure.caption.58}\protected@file@percent }
\newlabel{fig:gamma_spec_12c_p2p_11b}{{53}{109}{Doppler-corrected $\gamma $-ray spectrum in coincidence with the $^{12}\mathrm {C}(p,2p)^{11}\mathrm {B}$ quasi-free scattering reaction. The prominent peak at $E_{\gamma } \approx 2.1\,\mathrm {MeV}$ corresponds to the de-excitation of the $^{11}\mathrm {B}$ nucleus from its first excited state ($1/2^-$) to the ground state. This peak is fitted with a Gaussian function (blue), while the underlying background is described by an exponential distribution (green). A broader and less well-defined structure is observed at $E_{\gamma } \approx 5\,\mathrm {MeV}$, associated with the de-excitation of the $3/2^-$ state. \relax }{figure.caption.58}{}}
\newlabel{fig:gamma_spec_12c_p2p_11b@cref}{{[figure][53][]53}{[1][108][]109}}
